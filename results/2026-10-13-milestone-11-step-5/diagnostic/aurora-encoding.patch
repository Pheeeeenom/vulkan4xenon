+// Milestone 11, step 5's console diagnostics: GX draws counted, and skipped, by the features step 5 drew. Bits:
+// lit, fog, range fog, indirect, PNMTXIDX, TEXnMTXIDX, none of them.
+constexpr size_t FeatureCount = 7;
+std::atomic<uint32_t> g_skipFeatures = 0;
+std::array<std::atomic<uint64_t>, FeatureCount> g_featureDraws{};
+std::array<std::atomic<uint64_t>, FeatureCount> g_featureVertices{};
