+// GX draws whose features (draw_features) meet the mask aren't drawn.
+extern "C" void aurora_vulkan4xenon_skip_features(unsigned int mask) {
+  aurora::gfx::vulkan4xenon::g_skipFeatures.store(mask, std::memory_order_relaxed);
+}
+
+// The draws and vertices drawn with each feature since the last call, 7 of each.
+extern "C" void aurora_vulkan4xenon_take_feature_draws(unsigned long long* draws, unsigned long long* vertices) {
