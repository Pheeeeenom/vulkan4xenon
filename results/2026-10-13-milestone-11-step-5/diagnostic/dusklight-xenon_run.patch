+void log_diagnostics(u32 frames) {
+    const double perFrame = frames == 0 ? 0.0 : 1e-6 / frames;
+    DuskLog.info(
+        "Diagnostics: a frame's GPU {:.1f} ms, render worker {:.1f} ms (acquire {:.1f}), FIFO worker {:.1f} ms",
+        aurora_gpu_take_busy_ns() * perFrame, aurora_render_take_busy_ns() * perFrame,
+        aurora_vulkan4xenon_take_acquire_ns() * perFrame, aurora_fifo_take_busy_ns() * perFrame);
+    unsigned long long draws[7];
+    unsigned long long vertices[7];
+    aurora_vulkan4xenon_take_feature_draws(draws, vertices);
+    std::string line;
+    for (int i = 0; i < 7; ++i) {
+        line += fmt::format("{}{}: {:.0f} draws, {:.0f} vertices", i == 0 ? "" : "; ", FeatureNames[i],
+            frames == 0 ? 0.0 : double(draws[i]) / frames, frames == 0 ? 0.0 : double(vertices[i]) / frames);
+    }
+    DuskLog.info("Diagnostics: a frame's draws by feature: {}", line);
+    if (inTitle) {
+        const unsigned int skip =
+            TitleSkips[std::min<size_t>(titlePeriods++, std::size(TitleSkips) - 1)];
+        aurora_vulkan4xenon_skip_features(skip);
+        titlePeriodStart = Clock::now();
+        titlePeriodCaptured = false;
+        std::string names;
+        for (int i = 0; i < 6; ++i) {
+            if ((skip & (1u << i)) != 0) {
+                names += names.empty() ? FeatureNames[i] : fmt::format(", {}", FeatureNames[i]);
+            }
+        }
+        DuskLog.info("Diagnostics: the next period skips draws with: {}", names.empty() ? "nothing" : names);
+    }
+}
+#endif
